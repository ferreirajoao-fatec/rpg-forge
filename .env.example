# Banco local criado com: npx prisma dev -n rpg-forge -d
# (ou use o docker-compose.yml e a URL comentada abaixo)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# DATABASE_URL="postgresql://rpgforge:rpgforge@localhost:5433/rpgforge?schema=public"

# Conta de teste local usada nos testes de ponta a ponta (somente desenvolvimento)
E2E_TEST_EMAIL="aventureiro.teste@rpgforge.test"
E2E_TEST_PASSWORD="ForjaTeste2026x"
E2E_TEST_EMAIL_2="intrusa.teste@rpgforge.test"
E2E_TEST_PASSWORD_2="ForjaTeste2026y"

# Retratos com IA (opcional). Sem um provedor de imagem e o acesso ao Blob, a página do avatar mostra só o editor manual.
# Provedor: AI_PORTRAIT_PROVIDER="cloudflare" ou "gemini"; sem ela, usa o primeiro configurado (Cloudflare, depois Gemini).
# AI_PORTRAIT_PROVIDER=""
# Cloudflare Workers AI (cota grátis diária, modelo FLUX.1 schnell; não usa o avatar desenhado como referência).
# ID da conta: painel do Cloudflare. Token: My Profile > API Tokens, com a permissão "Workers AI".
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
# Gemini (exige faturamento ativo no Google; aceita o avatar desenhado como referência). https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Blob (privado). Na Vercel, o store conectado ao projeto usa OIDC: BLOB_STORE_ID + o token OIDC injetado.
# Localmente: `vercel env pull` traz BLOB_STORE_ID e VERCEL_OIDC_TOKEN (vale ~12 h), ou use um BLOB_READ_WRITE_TOKEN.
# BLOB_STORE_ID=""
# BLOB_READ_WRITE_TOKEN=""
# Modelo do Gemini (padrão: gemini-nano-banana-2.1) e limite de gerações por usuário a cada 24 h (padrão: 10)
# GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
# AI_PORTRAIT_DAILY_LIMIT="10"
