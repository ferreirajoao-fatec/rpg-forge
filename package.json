{
  "name": "rpg-forge",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @rpg-forge/web dev",
    "dev:clean": "node scripts/dev-clean.mjs && pnpm dev",
    "preview": "node scripts/dev-clean.mjs && pnpm build && pnpm start",
    "build": "pnpm --filter @rpg-forge/web build",
    "start": "pnpm --filter @rpg-forge/web start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @rpg-forge/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "content:import": "tsx apps/web/scripts/import-content.ts",
    "srd:fetch": "tsx scripts/srd/fetch.ts",
    "srd:build": "tsx scripts/srd/build.ts",
    "db:cleanup": "tsx apps/web/scripts/db-cleanup.ts",
    "postinstall": "prisma generate",
    "assets:build": "pnpm --filter @rpg-forge/avatar-engine assets:build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
